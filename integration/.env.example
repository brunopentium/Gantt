# Repositório PRIVADO de backups, não o repositório público do aplicativo.
GITHUB_REPOSITORY=brunopentium/gantt-backups
GITHUB_TOKEN=
# Vazio usa a branch padrão informada pelo GitHub.
GITHUB_BRANCH=
# Somente Trabalho por padrão. Pessoal exige habilitação explícita.
PROJECTFLOW_WORKSPACES=work
HOST=127.0.0.1
PORT=8787
# URL externa HTTPS do servidor de integração, sem /mcp no final.
PUBLIC_URL=https://projectflow-api.example.com
# Provedor OAuth/OIDC com authorization code + PKCE (S256).
OAUTH_ISSUER=https://identity.example.com/
OAUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# O provedor deve emitir access tokens com esse audience e expiração.
OAUTH_AUDIENCE=https://projectflow-api.example.com/mcp
# IDs sub autorizados (separados por vírgula); obrigatório no HTTP.
OAUTH_SUBJECTS=
# Para CLI remota: token de ACESSO OAuth, não o token do GitHub.
PROJECTFLOW_URL=https://projectflow-api.example.com
PROJECTFLOW_ACCESS_TOKEN=
