{
  "name": "projectflow-gantt",
  "private": true,
  "scripts": {
    "test:integration": "npm --prefix integration test",
    "test": "node scripts/test-suite.cjs",
    "build:todo": "node scripts/build-todo.cjs",
    "test:personal": "node --require ./tests/pwa-test-setup.cjs tests/personal-workspace.cjs",
    "test:notes:ocr": "node --require ./tests/pwa-test-setup.cjs tests/notes-ocr.cjs",
    "test:notes:chat": "node tests/notes-search.cjs && node --require ./tests/pwa-test-setup.cjs tests/notes-chat.cjs",
    "test:notes:vision": "node --require ./tests/pwa-test-setup.cjs tests/notes-vision.cjs",
    "test:notes:capture": "node --require ./tests/pwa-test-setup.cjs tests/notes-capture.cjs",
    "test:notes:selection": "node --require ./tests/pwa-test-setup.cjs tests/notes-selection.cjs",
    "test:notes:touch": "node --require ./tests/pwa-test-setup.cjs tests/notes-touch.cjs",
    "test:notes:edits": "node --require ./tests/pwa-test-setup.cjs tests/notes-edits.cjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.62.1",
    "tailwindcss": "3.4.19"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
